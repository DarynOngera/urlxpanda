# URLXpanda Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8000
CORS_ORIGIN=*

# URL Expansion Settings
MAX_REDIRECTS=10
REQUEST_TIMEOUT=10

# Google Safe Browsing API (Optional)
# Get your API key from: https://console.cloud.google.com/
# Enable "Safe Browsing API" in your Google Cloud project
# Free tier: 10,000 requests/day
GOOGLE_SAFE_BROWSING_API_KEY=

# Python Version (for deployment platforms)
PYTHON_VERSION=3.11

# Notes:
# - Without GOOGLE_SAFE_BROWSING_API_KEY: Uses pattern matching only
# - With GOOGLE_SAFE_BROWSING_API_KEY: Real-time threat detection via Google
# - CORS_ORIGIN=* allows all origins (use specific domain in production)
# - MAX_REDIRECTS: Maximum number of redirects to follow (default: 10)
# - REQUEST_TIMEOUT: Timeout in seconds for HTTP requests (default: 10)
